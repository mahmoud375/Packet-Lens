# ==============================================================================
# PacketLens NIPS v2.0 — Environment Configuration
# ==============================================================================
#
# Copy this file to .env before running:
#   cp .env.example .env
#
# Then customize the values below.
# docker-compose.yml reads ALL variables from this file automatically.
#
# NEVER commit the .env file to version control.
# ==============================================================================


# ──────────────────────────────────────────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────────────────────────────────────────

POSTGRES_DB=packetlens_v2
POSTGRES_USER=packetlens_v2
POSTGRES_PASSWORD=supersecret
POSTGRES_PORT=5433

# Computed DSN (used by Go services internally — no need to edit)
# docker-compose.yml interpolates the vars above into this.
# If you change user/pass/db/port above, the DSN updates automatically.

# ──────────────────────────────────────────────────────────────────────────────
# Network Interface (Sniffer)
# ──────────────────────────────────────────────────────────────────────────────

# The network interface to capture packets from.
# Use "any" to capture from all interfaces, or specify one (e.g., eth0, wlp2s0).
INTERFACE=wlp2s0

# ──────────────────────────────────────────────────────────────────────────────
# Alerting (Telegram / Slack / Generic Webhook)
# ──────────────────────────────────────────────────────────────────────────────

# Webhook URL for alert delivery.
# Telegram:  https://api.telegram.org/bot<TOKEN>/sendMessage
# Slack:     https://hooks.slack.com/services/T.../B.../xxx
# Generic:   Any URL that accepts POST with JSON body
ALERT_WEBHOOK_URL=

# Type of webhook: "telegram", "slack", or "generic"
ALERT_WEBHOOK_TYPE=generic

# Required for Telegram only: the chat ID to send alerts to.
# Get it from @userinfobot or @getidsbot on Telegram.
ALERT_TELEGRAM_CHAT_ID=

# ──────────────────────────────────────────────────────────────────────────────
# REST API (Go + Gin)
# ──────────────────────────────────────────────────────────────────────────────

API_PORT=8080

# ──────────────────────────────────────────────────────────────────────────────
# Dashboard (Next.js)
# ──────────────────────────────────────────────────────────────────────────────

# Port the dashboard listens on inside the container (and on host via network_mode: host)
DASHBOARD_PORT=3001

# The URL the dashboard uses to reach the Go API.
# With network_mode: host, services communicate via localhost.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# ──────────────────────────────────────────────────────────────────────────────
# Authentication (Directive 3 — pre-wired, unused until JWT is implemented)
# ──────────────────────────────────────────────────────────────────────────────

# Secret key for signing JWT tokens. Generate a strong random string:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-64-char-hex-string

# Hardcoded admin credentials for initial deployment.
# Change these before exposing the system to any network.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=packetlens-admin

# ──────────────────────────────────────────────────────────────────────────────
# Grafana
# ──────────────────────────────────────────────────────────────────────────────

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
