# ===========================
# PACKETLENS DATA (Critical)
# ===========================

# 1. Ignore Raw Data (GBs size)
data/raw/

# 2. Ignore Large Training Sets (>100MB Limit on GitHub)
# These files are too big for standard Git.
data/processed/X_train.parquet
data/processed/X_test.parquet

# Note: We keep y_train/y_test because they are small (<3MB)
# We also keep all .json and .pkl artifacts because the system needs them.

.agent/
/sniffer
/cmd
services/inference/model_store/model.json

